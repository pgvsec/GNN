# so they are NOT globally ignored — LFS handles them when staged.
cache/
runs/
tmp_*/

# Logs and outputs (except those explicitly LFS-tracked)
*.log
slurm_*.out
slurm_*.err
corpus_c_*.out
corpus_c_*.err

